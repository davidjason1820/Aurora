<footer class="footer-section color-scheme-{{ section.settings.color_scheme }}" role="contentinfo">
  <div class="page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <h3 class="footer__heading">{{ block.settings.title | escape }}</h3>
              <ul class="footer__menu list-unstyled">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              {%- if block.settings.title != blank -%}
                <h3 class="footer__heading">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- when 'social' -%}
              <h3 class="footer__heading">{{ block.settings.title | escape }}</h3>
              <div class="footer__social">
                {%- if block.settings.instagram != blank -%}<a href="{{ block.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">IG</a>{%- endif -%}
                {%- if block.settings.facebook != blank -%}<a href="{{ block.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">FB</a>{%- endif -%}
                {%- if block.settings.tiktok != blank -%}<a href="{{ block.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">TT</a>{%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}

      {%- if section.settings.enable_newsletter -%}
        <div class="footer__block footer__block--newsletter">
          <h3 class="footer__heading">{{ 'sections.footer.newsletter' | t }}</h3>
          {% form 'customer', class: 'newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email_label' | t }}</label>
            <div class="newsletter-form__field">
              <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email_placeholder' | t }}" required autocomplete="email">
              <button type="submit" class="btn btn--primary">{{ 'newsletter.button_label' | t }}</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        <span class="footer__powered-by">{{ powered_by_link }}</span>
      </p>
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payments list-unstyled" aria-label="{{ 'general.payments' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Link list title" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "About us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information with your customers here.</p>" }
      ]
    },
    {
      "type": "social",
      "name": "Social media",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Follow us" },
        { "type": "url", "id": "facebook", "label": "Facebook URL" },
        { "type": "url", "id": "instagram", "label": "Instagram URL" },
        { "type": "url", "id": "tiktok", "label": "TikTok URL" }
      ]
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_newsletter",
      "label": "Enable newsletter signup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" }
      ],
      "default": "3"
    }
  ]
}
{% endschema %}
