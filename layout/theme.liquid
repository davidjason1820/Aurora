<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  {% render 'meta-social' %}

  {{ 'base.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.classList.add('js');
    window.theme = {
      routes: {
        search: '{{ routes.search_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      },
      strings: {
        addToCart: "{{ 'products.product.add_to_cart' | t | escape }}",
        soldOut: "{{ 'products.product.sold_out' | t | escape }}",
        unavailable: "{{ 'products.product.unavailable' | t | escape }}",
        regularPrice: "{{ 'products.product.regular_price' | t | escape }}",
        salePrice: "{{ 'products.product.sale_price' | t | escape }}"
      }
    };
  </script>

  {% block head %}{% endblock %}

  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type | handle }}">
  <a class="skip-link visually-hidden focusable" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</body>
</html>
