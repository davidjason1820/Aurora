<main id="MainContent" class="article-template" role="main">
  <div class="page-width width--narrow">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.title' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home_link_title' | t }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
    </nav>

    <article>
      <h1 class="article-title">{{ article.title | escape }}</h1>
      <p class="article-meta">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'on_date' }}</time>
        {%- if article.author != blank -%} · {{ article.author }}{%- endif -%}
      </p>

      {%- if article.image -%}
        <div class="article-image">
          {{ article.image | image_url: width: 1500 | image_tag: class: 'article-image__img', widths: '750, 1100, 1500' }}
        </div>
      {%- endif -%}

      <div class="rte article-content">
        {{ article.content }}
      </div>

      {%- if article.tags.size > 0 -%}
        <ul class="article-tags list-unstyled">
          {%- for tag in article.tags -%}
            <li><a href="{{ blog.url }}/tags/{{ tag | handleize }}">#{{ tag }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </article>

    {%- if blog.comments_enabled? -%}
      <section class="article-comments" id="comments">
        <h2>{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>

        {%- if article.comments_count > 0 -%}
          <ul class="comment-list list-unstyled">
            {%- for comment in article.comments -%}
              <li class="comment">
                <p class="comment-body">{{ comment.content }}</p>
                <p class="comment-meta">{{ comment.author }} <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: format: 'on_date' }}</time></p>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {% form 'new_comment', article %}
          <h3>{{ 'blogs.comments.form_title' | t | default: 'Leave a comment' }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="form-success" role="status">{{ 'blogs.comments.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="form-error" role="alert">{{ 'blogs.comments.error' | t }}</p>
          {%- endif -%}
          <input type="text" name="comment[author]" placeholder="{{ 'blogs.comments.name' | t }}" required value="{{ form.author }}">
          <input type="email" name="comment[email]" placeholder="{{ 'blogs.comments.email' | t }}" required value="{{ form.email }}">
          <textarea name="comment[body]" rows="5" placeholder="{{ 'blogs.comments.message' | t }}" required>{{ form.body }}</textarea>
          <button type="submit" class="btn btn--primary">{{ 'blogs.comments.post' | t }}</button>
        {% endform %}
      </section>
    {%- endif -%}
  </div>
</main>

{% schema %}
{
  "name": "Article page",
  "tag": "main"
}
{% endschema %}
