<main id="MainContent" class="collection-template" role="main">
  <div class="page-width">
    <header class="collection-header">
      <h1 class="collection-title">
        {{- collection.title | escape -}}
        {%- if current_tags -%}
          <span class="filter-active-tag">{{ 'tags.general.title' | t }}: {{ current_tags | join: ', ' }}</span>
          <a href="{{ collection.url }}" class="clear-filter">{{ 'collections.general.clear_filter' | t | default: 'Clear' }}</a>
        {%- endif -%}
      </h1>
      {%- if collection.description != blank -%}
        <div class="rte collection-description">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- assign products_to_display = section.settings.products_per_page -%}
    <div class="collection-toolbar">
      <p class="result-count">
        {{ 'collections.general.product_count' | t: count: collection.products_count | default: collection.products_count }}
      </p>
      {% paginate collection.products by products_to_display %}
        <form method="get" action="{{ collection.url }}" class="sort-by-form">
          <label for="SortBy">{{ 'collections.sorting.title' | t | default: 'Sort by' }}</label>
          <select name="sort_by" id="SortBy" onchange="this.form.submit()">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {% endpaginate %}
    </div>

    {% paginate collection.products by products_to_display %}
      <div class="product-grid grid--{{ section.settings.columns_desktop }} columns">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
        {%- else -%}
          <p>{{ 'collections.general.no_matches' | t }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.title' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">&laquo;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">&raquo;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {% endpaginate %}
  </div>
</main>

{% schema %}
{
  "name": "Collection page",
  "tag": "main",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 16 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
  ]
}
{% endschema %}
