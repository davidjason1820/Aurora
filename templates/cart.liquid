<main id="MainContent" class="cart-template" role="main">
  <div class="page-width">
    <h1 class="cart-title">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">
        <input type="hidden" name="checkout_url" value="">
        <table class="cart-table" summary="{{ 'cart.label.summary' | t }}">
          <thead>
            <tr>
              <th scope="col">{{ 'cart.label.product' | t }}</th>
              <th scope="col">{{ 'cart.label.price' | t }}</th>
              <th scope="col">{{ 'cart.label.quantity' | t }}</th>
              <th scope="col">{{ 'cart.label.total' | t }}</th>
              <th scope="col"><span class="visually-hidden">{{ 'cart.label.remove' | t }}</span></th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr class="cart-item" data-line-key="{{ item.key }}">
                <td class="cart-item__product" data-label="{{ 'cart.label.product' | t }}">
                  <a href="{{ item.url }}" class="cart-item__link">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 200 | image_tag: class: 'cart-item__image', widths: '80, 120, 200' }}
                    {%- endif -%}
                    <div class="cart-item__details">
                      <p class="cart-item__title">{{ item.product.title | escape }}</p>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
                      {%- endunless -%}
                      {%- if item.selling_plan_allocation -%}
                        <p class="cart-item__selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}
                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <p class="cart-item__property">{{ property.first }}: {{ property.last }}</p>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </a>
                </td>
                <td class="cart-item__price" data-label="{{ 'cart.label.price' | t }}">
                  {% render 'price', product: item.product, variant: item.variant, use_minimum_false: true %}
                </td>
                <td class="cart-item__quantity" data-label="{{ 'cart.label.quantity' | t }}">
                  <label class="visually-hidden" for="CartQuantity-{{ item.key }}">{{ 'cart.label.quantity' | t }}</label>
                  <input
                    type="number"
                    id="CartQuantity-{{ item.key }}"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="cart-item__quantity-input"
                    data-line-index="{{ forloop.index0 }}"
                  >
                </td>
                <td class="cart-item__total" data-label="{{ 'cart.label.total' | t }}">
                  {{ item.final_line_price | money }}
                </td>
                <td class="cart-item__remove" data-label="{{ 'cart.label.remove' | t }}">
                  <a href="{{ item.url_to_remove }}" class="cart-item__remove-link" data-cart-remove>
                    &times;<span class="visually-hidden">{{ 'cart.label.remove_item' | t }}</span>
                  </a>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-subtotals">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <p class="discount-row">{{ discount.title }} (-{{ discount.total_allocated_amount | money }})</p>
            {%- endfor -%}
          {%- endif -%}
          <p class="subtotal-row">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </p>
          <p class="tax-note small-text">
            {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
              {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url | default: 'Taxes included, shipping calculated at checkout' }}
            {%- elsif cart.taxes_included -%}
              {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
            {%- elsif shop.shipping_policy.body != blank -%}
              {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url | default: 'Taxes and shipping calculated at checkout' }}
            {%- else -%}
              {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
            {%- endif -%}
          </p>
        </div>

        <div class="cart-checkout">
          {%- if section.settings.show_notes -%}
            <details class="cart-note">
              <summary>{{ 'cart.general.note' | t }}</summary>
              <label class="visually-hidden" for="CartNote">{{ 'cart.general.order_note' | t }}</label>
              <textarea name="note" id="CartNote" rows="3" placeholder="{{ 'cart.general.order_note_placeholder' | t }}">{{ cart.note }}</textarea>
            </details>
          {%- endif -%}

          <div class="cart-buttons">
            <button type="submit" name="update" class="btn btn--secondary">{{ 'cart.general.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.general.checkout' | t }}</button>
          </div>

          {%- if additional_checkout_buttons -%}
            <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</main>

{% schema %}
{
  "name": "Cart page",
  "tag": "main",
  "settings": [
    { "type": "checkbox", "id": "show_notes", "label": "Enable order notes", "default": true }
  ]
}
{% endschema %}
